{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "dim",
      "type": "row",
      "padding": 6,
      "gap": 6,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "sidebar-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "workspaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents-panel"
                  },
                  "size": {
                    "px": 140
                  }
                },
                {
                  "id": "usage",
                  "type": "block",
                  "content": {
                    "mod": "usage"
                  },
                  "size": {
                    "px": 164
                  }
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "sidebar-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 40
              }
            }
          ],
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "#171c1f7d",
          "resizable": false,
          "radius": 10
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "row",
              "gap": 4,
              "children": [
                {
                  "id": "tabs-strip",
                  "type": "block",
                  "content": {
                    "mod": "tabs-bar",
                    "props": {
                      "windowControls": false
                    }
                  },
                  "size": {
                    "weight": 1
                  },
                  "window_drag": true
                },
                {
                  "id": "insights-toolbar-button",
                  "type": "block",
                  "content": {
                    "mod": "insights",
                    "props": {
                      "mode": "toolbar",
                      "transparent": true
                    }
                  },
                  "size": {
                    "px": 74
                  },
                  "window_drag": true
                },
                {
                  "id": "markdown-docs-button",
                  "type": "block",
                  "content": {
                    "mod": "markdown-docs",
                    "props": {
                      "role": "toolbar",
                      "transparent": true
                    }
                  },
                  "size": {
                    "px": 98
                  },
                  "window_drag": true
                },
                {
                  "id": "inbox-button",
                  "type": "block",
                  "content": {
                    "mod": "inbox",
                    "props": {
                      "role": "inbox-button",
                      "align": "start",
                      "autoWidth": true,
                      "icon": true,
                      "transparent": true
                    }
                  },
                  "size": {
                    "px": 82
                  },
                  "window_drag": true
                },
                {
                  "id": "panel-toggle",
                  "type": "block",
                  "content": {
                    "mod": "inbox",
                    "props": {
                      "role": "panel-toggle",
                      "transparent": true
                    }
                  },
                  "size": {
                    "px": 34
                  },
                  "window_drag": true
                },
                {
                  "id": "window-controls",
                  "type": "block",
                  "content": {
                    "mod": "window-controls",
                    "props": {
                      "transparent": true
                    }
                  },
                  "size": {
                    "px": 76
                  },
                  "window_drag": true
                }
              ],
              "resizable": false,
              "size": {
                "px": 40
              },
              "window_drag": true,
              "background": "#171c1f7d",
              "radius": 10
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "background": "background",
                      "radius": 10,
                      "gap": 6,
                      "lone": true,
                      "header": {
                        "content": {
                          "mod": "pane-header"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files-panel"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes-panel"
                          }
                        },
                        {
                          "id": "graph",
                          "type": "block",
                          "content": {
                            "mod": "git-graph"
                          }
                        },
                        {
                          "id": "inbox",
                          "type": "block",
                          "content": {
                            "mod": "inbox",
                            "props": {
                              "role": "inbox"
                            }
                          }
                        },
                        {
                          "id": "issues",
                          "type": "block",
                          "content": {
                            "mod": "issues"
                          }
                        },
                        {
                          "id": "markdown-docs",
                          "type": "block",
                          "content": {
                            "mod": "markdown-docs"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "background": "#171c1f7d",
                  "radius": 10
                }
              ],
              "padding": [
                6,
                0
              ],
              "gap": 6
            },
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "status-bar"
              },
              "size": {
                "px": 32
              },
              "background": "#171c1f7d",
              "radius": 10
            },
            {
              "id": "keybinds",
              "type": "block",
              "content": {
                "mod": "keybinds"
              },
              "size": {
                "px": 0
              }
            }
          ],
          "resizable": false,
          "gap": 0
        }
      ]
    }
  ],
  "background": "#08070c",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    18,
    20
  ],
  "padding": 0,
  "gap": 0,
  "theme": {
    "light": "paper",
    "dark": "rose-pine"
  },
  "font": "Maple Mono NF CN",
  "font_size": 14
}